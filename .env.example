# Copy this to .env and fill in your values
# ModelRouter will read from environment variables

# Required: Google AI Studio API key (free at https://aistudio.google.com)
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Router port (default 8082)
# ROUTER_PORT=8082

# Optional: Local Ollama model (default gemma3:1b)
# OLLAMA_MODEL=gemma3:1b

# Optional: Ollama host (default http://127.0.0.1:11434)
# OLLAMA_HOST=http://127.0.0.1:11434
